# =====================================================================
# Plantilla de configuración (ejemplo).
# Copie este archivo como ".env" y complete los valores reales.
# NO suba el ".env" real al repositorio.
# =====================================================================

# Credenciales PostgreSQL
DB_NAME=bdatx
DB_USER=postgres
DB_PASSWORD=<TU_CONTRASENA>
DB_HOST=localhost
DB_PORT=5432

# Ruta del ejecutable psql (carga de la base)
PSQL_PATH=C:\Program Files\PostgreSQL\17\bin\psql.exe

# Descarga de la base BDATx
DOWNLOAD_URL=https://activos-tx-prod.appspot.com/api/v1/public-database-download/
BASE_FOLDER=C:/Users/Public/bdatx
